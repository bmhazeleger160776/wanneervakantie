---
import Base from "../../layouts/Base.astro";
import Aftellen from "../../components/Aftellen.astro";
import { GEMEENTEN, REGIO_NAAM, VAKANTIES, komende, gemeentenInRegio } from "../../lib/vakanties.js";
import { kort, volledig, vandaag, periode } from "../../lib/datum.js";

export function getStaticPaths() {
  return GEMEENTEN.map((g) => ({ params: { gemeente: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const r = g.regio;
const naam = REGIO_NAAM[r];
const nu = vandaag();
const lijst = komende(nu, r, 10);
const zomer = lijst.find((v) => v.type === "zomervakantie");
const buren = gemeentenInRegio(r).filter((x) => x.provincie === g.provincie && x.slug !== g.slug).slice(0, 12);
const faq = [
  { v: `In welke regio valt ${g.naam}?`, a: g.opmerking ? `${g.naam} valt grotendeels in regio ${naam}. ${g.opmerking}` : `${g.naam} (${g.provincie}) valt in regio ${naam} voor de schoolvakanties.` },
  zomer && { v: `Wanneer is de zomervakantie ${zomer.jaar} in ${g.naam}?`, a: `Scholen in ${g.naam} hebben zomervakantie van ${volledig(zomer.regios[r].start)} tot en met ${volledig(zomer.regios[r].eind)}.` },
  { v: `Geldt dit voor alle scholen in ${g.naam}?`, a: "De regio geldt voor basisscholen en middelbare scholen in de gemeente. Voor herfst-, voorjaars- en meivakantie geeft het ministerie adviesdata; scholen mogen daarvan afwijken. Kijk voor de zekerheid in de schoolgids." },
].filter(Boolean);
const jsonLd = [{ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) }];
---
<Base title={`Schoolvakanties ${g.naam} – regio ${naam}`} description={`${g.naam} valt in regio ${naam}. ${zomer ? `Zomervakantie ${zomer.jaar}: ${periode(zomer.regios[r].start, zomer.regios[r].eind)}. ` : ""}Alle schoolvakanties voor ${g.naam} op een rij, met aftellen.`} canonical={`/gemeente/${g.slug}`} jsonLd={jsonLd} kruimels={[{ naam: "Gemeenten", url: "/gemeente/" }, { naam: g.naam }]}>
  <h1>Schoolvakanties {g.naam}</h1>
  <p class="intro">{g.naam} ({g.provincie}) valt in <a href={`/regio/${r}`} class={`regio ${r}`} style="text-decoration:none">regio {naam}</a>.{g.opmerking && <> {g.opmerking}</>}</p>
  <Aftellen vakanties={VAKANTIES} regio={r} />

  <h2>Komende schoolvakanties in {g.naam}</h2>
  <div class="tabelwrap"><table>
    <thead><tr><th>Vakantie</th><th>Periode</th></tr></thead>
    <tbody>{lijst.map((v) => (
      <tr class={v.regios[r].start <= nu && v.regios[r].eind >= nu ? "nu" : ""}>
        <td><a href={`/${v.slug}`}><strong>{v.naam} {v.jaar}</strong></a>{!v.verplicht && <span class="muted klein"> · advies</span>}</td>
        <td class="nw">{kort(v.regios[r].start)} – {kort(v.regios[r].eind)} {v.regios[r].eind.slice(0, 4)}</td>
      </tr>
    ))}</tbody>
  </table></div>
  <p class="muted klein">Adviesdata: scholen mogen afwijken. Check de schoolgids. <a href={`/agenda/?regio=${r}`}>Zet alle vakanties van regio {naam} in je agenda →</a></p>

  <h2>Veelgestelde vragen</h2>
  {faq.map((f) => <details><summary>{f.v}</summary><p>{f.a}</p></details>)}

  {buren.length > 0 && (<>
    <h2>Andere gemeenten in {g.provincie} met regio {naam}</h2>
    <ul class="chips">{buren.map((x) => <li><a href={`/gemeente/${x.slug}`}>{x.naam}</a></li>)}</ul>
  </>)}
  <p class="meer"><a href={`/regio/${r}`}>Alle gemeenten in regio {naam} →</a></p>
</Base>
