---
import Base from "../../layouts/Base.astro";
import { REGIOS, REGIO_NAAM } from "../../lib/vakanties.js";
import { SITE } from "../../lib/site.js";
const code = (r) => `<iframe src="${SITE.url}/widget/${r}" width="320" height="230" style="border:0" title="Schoolvakanties regio ${REGIO_NAAM[r]}" loading="lazy"></iframe>`;
---
<Base title="Gratis schoolvakantie-widget voor je website" description="Zet de schoolvakanties van jouw regio gratis op je website. Voor scholen, kinderopvang, sportclubs en verenigingen. Altijd actueel, met aftellen." canonical="/widget/" kruimels={[{ naam: "Widget" }]}>
  <h1>Gratis schoolvakantie-widget</h1>
  <p class="intro">Zet de komende schoolvakanties van jouw regio op je eigen website. Handig voor scholen, kinderopvang, sportclubs en verenigingen. De widget telt af naar de volgende vakantie en wordt vanzelf bijgewerkt.</p>
  <h2>Voorbeeld</h2>
  <iframe src="/widget/midden" width="320" height="230" style="border:0" title="Voorbeeld widget" loading="lazy"></iframe>
  <h2>Code kopiëren</h2>
  <p>Kies je regio, kopieer de code en plak hem in je website (bijvoorbeeld in een HTML-blok in WordPress).</p>
  {REGIOS.map((r) => (
    <div class="codeblok">
      <p><span class={`regio ${r}`}>Regio {REGIO_NAAM[r]}</span></p>
      <textarea readonly rows="3">{code(r)}</textarea>
      <button type="button" class="knop kopieer" data-umami-event="widget-code-kopieren" data-umami-event-regio={r}>Kopieer code</button>
    </div>
  ))}
  <p class="muted">De widget plaatst geen cookies. Vragen of een andere maat nodig? Mail <a href={`mailto:${SITE.mail}`}>{SITE.mail}</a>.</p>
</Base>
<style>
  .codeblok { margin-bottom: 18px; }
  textarea { width: 100%; font: .85rem ui-monospace, monospace; padding: 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); resize: vertical; }
  .kopieer { margin-top: 6px; padding: 8px 14px; font-size: .9rem; }
</style>
<script>
  document.querySelectorAll(".kopieer").forEach((b) => b.addEventListener("click", async () => {
    const ta = b.parentElement.querySelector("textarea");
    try { await navigator.clipboard.writeText(ta.value); } catch { ta.select(); document.execCommand("copy"); }
    b.textContent = "Gekopieerd!"; setTimeout(() => (b.textContent = "Kopieer code"), 2000);
  }));
</script>
