---
import { GEMEENTEN } from "../lib/vakanties.js";
const { label = "Zoek je gemeente" } = Astro.props;
const id = "gem-" + Math.random().toString(36).slice(2, 7);
---
<form class="zoeker" action="/gemeente/" data-zoeker>
  <label for={id}>{label}</label>
  <div class="rij">
    <input id={id} name="q" list={`${id}-lijst`} placeholder="Bijvoorbeeld Ede of Rotterdam" autocomplete="off" required />
    <button class="knop" type="submit">Zoek</button>
  </div>
  <datalist id={`${id}-lijst`}>{GEMEENTEN.map((g) => <option value={g.naam} data-slug={g.slug} />)}</datalist>
  <p class="fout muted klein" hidden>Die gemeente kennen we niet. Kies een naam uit de lijst, of bekijk <a href="/gemeente/">alle gemeenten</a>.</p>
</form>
<style>
  .zoeker { margin: 14px 0; }
  .zoeker label { display: block; font-weight: 600; margin-bottom: 6px; }
  .rij { display: flex; gap: 8px; }
  .zoeker input { flex: 1; min-width: 0; font: inherit; padding: 11px 14px; border: 1.5px solid var(--line); border-radius: 10px; background: var(--card); }
  .zoeker input:focus { outline: none; border-color: var(--accent); }
</style>
<script>
  const norm = (s) => s.toLowerCase().normalize("NFKD").replace(/[̀-ͯ]/g, "").replace(/^gemeente\s+/, "").trim();
  document.querySelectorAll("[data-zoeker]").forEach((f) => {
    const opties = [...f.querySelectorAll("option")].map((o) => ({ n: norm(o.value), s: o.dataset.slug }));
    f.addEventListener("submit", (e) => {
      e.preventDefault();
      const q = norm(f.querySelector("input").value);
      const hit = opties.find((o) => o.n === q) || opties.find((o) => o.n.startsWith(q)) || opties.find((o) => o.n.includes(q));
      if (hit) location.href = `/gemeente/${hit.s}`;
      else f.querySelector(".fout").hidden = false;
    });
  });
</script>
